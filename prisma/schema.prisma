// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ユーザー管理
model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  nickname              String?
  onboardingCompleted   Boolean   @default(false)
  preferredAiModel      String    @default("claude-haiku")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  activities    Activity[]
  goals         Goal[]
  billing       Billing?
  accounts      Account[]
  sessions      Session[]
  aiUsageLogs   AiUsageLog[]

  @@map("users")
}

// NextAuth.js用テーブル
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 活動記録
model Activity {
  id              String    @id @default(cuid())
  userId          String
  activityDate    DateTime
  locationName    String
  latitude        Float?
  longitude       Float?
  durationMinutes Int?
  weather         String?
  staffCount      Int?
  dialogueCount   Int?
  memo            String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityResults ActivityResult[]

  @@index([userId, activityDate])
  @@map("activities")
}

// 成果指標定義
model Goal {
  id              String    @id @default(cuid())
  userId          String
  goalName            String
  outcomeName         String
  activityCountLabel  String    @default("対話人数")
  isPrimary           Boolean   @default(false)
  displayOrder    Int       @default(0)
  colorCode       String    @default("#3b82f6")
  monthlyTarget   Int?
  annualTarget    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityResults ActivityResult[]

  @@index([userId, displayOrder])
  @@map("goals")
}

// 活動成果実績（中間テーブル）
model ActivityResult {
  id            String   @id @default(cuid())
  activityId    String
  goalId        String
  activityCount Int      @default(0)
  resultCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([activityId, goalId])
  @@index([activityId])
  @@index([goalId])
  @@map("activity_results")
}

// AI分析利用ログ（月別）
model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  yearMonth String   // "2026-03" 形式
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
  @@map("ai_usage_logs")
}

// 課金データ
model Billing {
  id                    String   @id @default(cuid())
  userId                String   @unique
  plan                  String   @default("free") // free, standard
  squareOrderId         String?
  squareSessionId       String?  @unique
  currentPeriodEnd      DateTime?
  status                String   @default("active") // active, past_due, canceled
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("billing")
}
